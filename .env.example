# Public context collector settings. No private keys are required.
COLLECTOR_PROFILE=context
RSS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
CONTEXT_LOOKBACK_HOURS=12
GDELT_QUERIES=bitcoin OR ethereum OR crypto OR stablecoin
POLYMARKET_QUERY=crypto
POLYMARKET_MARKET_LIMIT=80
HISTORY_MAX_RECORDS=720
LOG_LEVEL=INFO

# Optional 5-minute flow-alert settings. Store DUNE_API_KEY as a GitHub Secret.
FLOW_ALERT_LOOKBACK_HOURS=24
FLOW_ALERT_HISTORY_MAX_RECORDS=2016
DUNE_LARGE_FLOW_QUERY_ID=
DUNE_RESULT_LIMIT=100
DUNE_RESULT_COLUMNS=block_time,tx_hash,wallet,usdc_amount,amount,amount_usd
