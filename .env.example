# ============================================================
# HyperLiquid connection
# ============================================================
# Public dry-run scans do not need a private key.
# Live trading requires an API wallet private key. If you use an API wallet,
# set HYPERLIQUID_ACCOUNT_ADDRESS to the main account address.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_TESTNET=false
HYPERLIQUID_API_URL=
HYPERLIQUID_DEX=
HYPERLIQUID_TIMEOUT_SECONDS=10
HYPERLIQUID_MARKET_SLIPPAGE=0.05
HYPERLIQUID_MIN_ORDER_NOTIONAL_USDC=10

# ============================================================
# Scanner settings
# ============================================================
BTC_BEARISH_THRESHOLD=-0.5
BTC_STAGNANT_THRESHOLD=0.2
ALT_SURGE_THRESHOLD=5.0
RELATIVE_STRENGTH_THRESHOLD=5.0
MIN_24H_VOLUME_USDT=1000000
MAX_OHLCV_CHECKS=50
SCAN_INTERVAL_SECONDS=300
RUN_ONCE=false

# ============================================================
# Analyzer settings
# ============================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=70
BB_PERIOD=20
BB_STD=2.0
ANALYSIS_TIMEFRAME=1h
OHLCV_LIMIT=100
RSI_4H_MAX=65
USE_4H_FILTER=true
VOLUME_LOOKBACK=20
VOLUME_RISING_RATIO=1.8
VOLUME_DECLINING_RATIO=0.8
ATR_PERIOD=14
USE_ATR_SL=true
ATR_SL_MULT=1.5
ATR_SL_MIN=1.0
ATR_SL_MAX=4.0
RISK_REWARD_RATIO=2.0
COOLDOWN_HOURS=48
CIRCUIT_BREAKER_WINDOW=10
CIRCUIT_BREAKER_LOSSES=5
CIRCUIT_BREAKER_LOOKBACK_HOURS=48

# ============================================================
# Execution and risk
# ============================================================
# Keep this true until the HyperLiquid API wallet is fully tested.
DRY_RUN=true
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
TRACKING_HOURS=24
LIVE_BASE_RISK_PCT=0.5
LIVE_MAX_RISK_PCT=1.5
LIVE_MAX_LEVERAGE=3.0
LIVE_MIN_BALANCE_USDT=5.0
LIVE_MAX_OPEN_POSITIONS=3
LIVE_SHORT_ONLY=true

# ============================================================
# Shadow experiment / market context
# ============================================================
EXPERIMENT_TRACKING_HOURS=8
EXPERIMENT_MAX_PER_CYCLE=20
EXPERIMENT_HOT_MAX=500
MARKET_CONTEXT_ENABLED=true
MARKET_CONTEXT_MAX_RECORDS=288
MARKET_CONTEXT_TOP_SYMBOLS=20
MARKET_CONTEXT_NEAR_MISS_LIMIT=30
MARKET_CONTEXT_ANALYSIS_SYMBOL_LIMIT=25

# ============================================================
# Fundamental analysis / notifications
# ============================================================
FUNDAMENTAL_LOOKBACK_HOURS=48
USE_REDDIT_NEWS=true
DISCORD_WEBHOOK_URL=

# ============================================================
# Live strategy tuning
# ============================================================
LIVE_RSI_MIN=0
LIVE_RSI_4H_MAX=65
LIVE_ATR_HIGH=9.0
LIVE_REL_STRENGTH_MIN=5.0
LIVE_REQUIRE_FUND_NON_AVOID=true
BLOCK_CONSEC_GREEN_1H=8
BLOCK_BBW_LO=15.0
BLOCK_BBW_HI=20.0
BLOCK_MA_DEV_LO=5.0
BLOCK_MA_DEV_HI=10.0
BLOCK_ATR_LO=5.0
BLOCK_ATR_HI=7.0
BLOCK_WICK_RATIO=0.6
BOOST_FUNDING_RATE=0.10
LIVE_MIN_EV_PCT=0.20
LIVE_MIN_RANKER_FILLED=10
LIVE_TIER_MULT_S=1.50
LIVE_TIER_MULT_A=1.20
LIVE_TIER_MULT_B=0.80
LIVE_BOOST_MULT=0.40
LIVE_LIMIT_OFFSET_PCT=7.0
LIVE_PATIENT_OFFSET_PCT=6.0
LIVE_SCALE_MARKET_WEIGHT=0.4
LIVE_LONG_BIAS_PCT=60.0
LIVE_SHORT_BIAS_PCT=40.0
LIVE_MOVE_BE_AT_RR=1.0
LIVE_PARTIAL_TP_RR=1.0
LIVE_PARTIAL_TP_RATIO=0.5
LIVE_VIRTUAL_CAPITAL=100

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/scanner.log
