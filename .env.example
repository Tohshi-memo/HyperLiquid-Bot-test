# Public context collector settings. No private keys are required.
COLLECTOR_PROFILE=context
RSS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
CONTEXT_LOOKBACK_HOURS=12
GDELT_QUERIES=bitcoin OR ethereum OR crypto OR stablecoin
POLYMARKET_QUERY=crypto
POLYMARKET_MARKET_LIMIT=80
HISTORY_MAX_RECORDS=8640
LOG_LEVEL=INFO

# Full HyperLiquid universe, lightweight price snapshots only.
ASSET_UNIVERSE_ENABLED=true
ASSET_UNIVERSE_BUCKET_MINUTES=15
ASSET_UNIVERSE_MAX_RECORDS=2880
ASSET_UNIVERSE_ACTIVE_RECORDS=672
ASSET_UNIVERSE_ARCHIVE_ENABLED=true
ASSET_UNIVERSE_TOP_LIMIT=25
ASSET_UNIVERSE_CLASS_TOP_LIMIT=10
ASSET_UNIVERSE_HIP3_DEXS=xyz

# Day/swing research dataset. Public market data only.
DAY_SWING_ENABLED=true
DAY_SWING_SYMBOLS=BTC,ETH,HYPE,SOL
DAY_SWING_INTERVALS=15m,1h,4h
DAY_SWING_LABEL_HORIZONS=1h,4h,24h,72h
DAY_SWING_BUCKET_MINUTES=15
DAY_SWING_CANDLE_LOOKBACK=80
DAY_SWING_MAX_RECORDS=12000
DAY_SWING_LABEL_MAX_DELAY_MINUTES=45

# AI quota-saving index and cross-market canary design.
AI_INDEX_ENABLED=true
CANARY_MIN_SAMPLES=24
CANARY_TOP_LIMIT=10

# Optional 5-minute flow-alert settings. Store DUNE_API_KEY as a GitHub Secret.
FLOW_ALERT_LOOKBACK_HOURS=24
FLOW_ALERT_HISTORY_MAX_RECORDS=8640
DUNE_LARGE_FLOW_QUERY_ID=
DUNE_RESULT_LIMIT=100
DUNE_RESULT_COLUMNS=block_time,tx_hash,wallet,usdc_amount,amount,amount_usd
